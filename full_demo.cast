[243.82251596450806,"o","\u001b[25l\u001b[m\u001b[HВы уверены, что хотите выполнить \"Удаление данных\"? [y/n]: y\u001b[K\r\nУдалено записей: 2.\u001b[K\r\n\u001b[K\r\nВведите команду: select from users\u001b[K\r\nФункция <select> выполнилась за 0.000 секунд.\u001b[K\r\n+----+------+-----+-----------+\u001b[K\r\n| ID | name | age | is_active |\u001b[K\r\n+----+------+-----+-----------+\u001b[K\r\n+----+------+-----+-----------+\u001b[K\r\n\u001b[K\r\nВведите команду: drop_table users\u001b[K\r\nВы уверены, что хотите выполнить \"Удаление таблицы\"? [y/n]: y\u001b[K\r\nТаблица \"users\" успешно удалена.\u001b[K\r\n\u001b[K\r\nВведите команду: list_tables\u001b[K\r\n-\u001b[K\r\n\u001b[K\r\nВведите команду: info users\u001b[K\r\nОшибка: Таблицы \"users\" не существует.\u001b[K\r\n\u001b[K\r\nВведите команду: exit\u001b[K\r\nВыход из программы\u001b[K\r\nPS C:\\Users\\admin\\Desktop\\project-2_Sidorenko_M26-555> \u001b[92mexit\u001b[m\u001b[K\r\n\u001b[K\u001b[59C\u001b[?25h"]
