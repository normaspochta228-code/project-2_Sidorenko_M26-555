[7.36456298828125,"o","\r\n***Процесс работы с таблицей***"]
[7.373188734054565,"o","\r\nФункции:\u001b[121X\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\u001b[57X\r\n<command> list_tables - показать список всех таблиц\u001b[78X\r\n<command> drop_table <имя_таблицы> - удалить таблицу\u001b[77X\r\n\u001b[129X\r\n***Операции с данными***\u001b[105X\r\nФункции:\u001b[121X\r\n<command> insert into <имя_таблицы> values (<значение1>, <значение2>, ...) - создать запись.\u001b[37X\r\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию.\u001b[34X\r\n<command> select from <имя_таблицы> - прочитать все записи.\u001b[70X\r\n<command> update <имя_таблицы> set <столбец1> = <новое_значение1> where <столбец_условия> = <значение_условия> - обновить запись.\r\n<command> delete from <имя_таблицы> where <с"]
[7.3734214305877686,"o","толбец> = <значение> - удалить записи по условию.\u001b[36X\r\n<command> delete from <имя_таблицы> - удалить все записи.\u001b[72X\r\n<command> info <имя_таблицы> - вывести информацию о таблице.\u001b[69X\r\n\u001b[129X\r\nОбщие команды:\u001b[115X\r\n<command> exit - выход из программы\u001b[94X\r\n<command> help - справочная информация\u001b[91X\r\n\u001b[129X\r\nВведите команду: \u001b[112X"]
